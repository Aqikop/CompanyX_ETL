    <DTS:Executable
      DTS:refId="Package\LoadProductDimSCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{134304A3-69E5-400B-9EC6-2C57D82077E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LoadProductDimSCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F75E5D8-3350-4192-A84C-92733B89D947}"
          SQLTask:SqlStatementSource="-- 1. Close versions that staging now shows as ended (or whose lifecycle changed).&#xA;--    Done first so the &quot;one current row per product&quot; index is never violated.&#xA;UPDATE d&#xA;SET    d.EffectiveTo = s.EffectiveTo,&#xA;       d.IsCurrent   = s.IsCurrent,&#xA;       d.SellEndDate = s.SellEndDate&#xA;FROM   dw.ProductDim AS d&#xA;JOIN   staging.ProductVersion AS s&#xA;       ON s.ProductID = d.ProductID&#xA;      AND s.EffectiveFrom = d.EffectiveFrom&#xA;WHERE  EXISTS (SELECT s.EffectiveTo, s.IsCurrent, s.SellEndDate&#xA;               EXCEPT&#xA;               SELECT d.EffectiveTo, d.IsCurrent, d.SellEndDate);&#xA;&#xA;-- 2. Insert versions that do not exist in the dimension yet.&#xA;INSERT INTO dw.ProductDim&#xA;    (ProductID, [Name], ProductNumber, Color, ListPrice, StandardCost,&#xA;     EffectiveFrom, EffectiveTo, IsCurrent,&#xA;     ProductModelID, ModelName, SubcategoryName, CategoryName, SellEndDate)&#xA;SELECT s.ProductID, s.[Name], s.ProductNumber, s.Color, s.ListPrice, s.StandardCost,&#xA;       s.EffectiveFrom, s.EffectiveTo, s.IsCurrent,&#xA;       s.ProductModelID, s.ModelName, s.SubcategoryName, s.CategoryName, s.SellEndDate&#xA;FROM   staging.ProductVersion AS s&#xA;WHERE  NOT EXISTS (SELECT 1 FROM dw.ProductDim AS d&#xA;                   WHERE d.ProductID = s.ProductID&#xA;                     AND d.EffectiveFrom = s.EffectiveFrom)&#xA;ORDER BY s.ProductID, s.EffectiveFrom;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Truncate staging ProductVersion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8EFC1CFA-B448-4091-8300-7E92AC702FFB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate staging ProductVersion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F75E5D8-3350-4192-A84C-92733B89D947}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE staging.ProductVersion;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
