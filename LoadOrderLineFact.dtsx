                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\Compute DateKey and DiscountAmount.Outputs[Derived Column Output].Columns[DateKey]"
                      name="DateKey"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[YEAR](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[OrderDate]}) * 10000 + [MONTH](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[OrderDate]}) * 100 + [DAY](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[OrderDate]})</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">YEAR(OrderDate) * 10000 + MONTH(OrderDate) * 100 + DAY(OrderDate)</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Data Flow Task\Compute DateKey and DiscountAmount.Outputs[Derived Column Output].Columns[DiscountAmount]"
                      dataType="numeric"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\Compute DateKey and DiscountAmount.Outputs[Derived Column Output].Columns[DiscountAmount]"
                      name="DiscountAmount"
                      precision="38"
                      scale="6"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[ISNULL](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[OrderQty]}) || [ISNULL](#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[UnitPrice]}) ? NULL(DT_NUMERIC,38,6) : (DT_NUMERIC,38,6)((DT_NUMERIC,19,4)#{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[OrderQty]} * #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[UnitPrice]} * #{Package\Data Flow Task\OLE DB Source.Outputs[OLE DB Source Output].Columns[UnitPriceDiscount]})</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">ISNULL(OrderQty) || ISNULL(UnitPrice) ? NULL(DT_NUMERIC,38,6) : (DT_NUMERIC,38,6)((DT_NUMERIC,19,4)OrderQty * UnitPrice * UnitPriceDiscount)</property>
                      </properties>
                    </outputColumn>
