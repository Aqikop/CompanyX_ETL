    <DTS:Executable
      DTS:refId="Package\LoadOrderLineFactLookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1BEAE578-3916-4683-9E9F-95DEF7B5FABD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LoadOrderLineFactLookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{500BEDBA-3FC8-41F4-BDB9-3B93CCECEC2F}"
          SQLTask:SqlStatementSource="INSERT INTO dw.OrderLineFact&#xA;    (SalesOrderID, SalesOrderDetailID, ProductKey, CustomerKey, DateKey,&#xA;     OrderQty, UnitPrice, UnitPriceDiscount, LineTotal, DiscountAmount,&#xA;     OnlineOrderFlag, ModifiedDate)&#xA;SELECT&#xA;    s.SalesOrderID,&#xA;    s.SalesOrderDetailID,&#xA;    pk.ProductKey,&#xA;    s.CustomerKey,&#xA;    s.DateKey,&#xA;    s.OrderQty,&#xA;    s.UnitPrice,&#xA;    s.UnitPriceDiscount,&#xA;    s.LineTotal,&#xA;    s.DiscountAmount,&#xA;    s.OnlineOrderFlag,&#xA;    s.ModifiedDate&#xA;FROM staging.OrderLine AS s&#xA;CROSS APPLY&#xA;(&#xA;    SELECT TOP (1) p.ProductKey&#xA;    FROM dw.ProductDim AS p&#xA;    WHERE p.ProductID = s.ProductID&#xA;    ORDER BY CASE WHEN s.OrderDate &gt;= p.EffectiveFrom&#xA;                   AND (p.EffectiveTo IS NULL OR s.OrderDate &lt;= p.EffectiveTo)&#xA;                  THEN 0 ELSE 1 END,&#xA;             p.EffectiveFrom DESC&#xA;) AS pk&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.OrderLineFact AS f&#xA;                  WHERE f.SalesOrderID = s.SalesOrderID&#xA;                    AND f.SalesOrderDetailID = s.SalesOrderDetailID);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\TruncateOrderLineStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0A0DE002-8E9B-4BD7-BC57-50201FDA5B96}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="TruncateOrderLineStaging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{500BEDBA-3FC8-41F4-BDB9-3B93CCECEC2F}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE staging.OrderLine;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
